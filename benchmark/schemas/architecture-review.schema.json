{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "rubric", "evidence", "runs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "rubric": {"type": "string"},
    "evidence": {"type": "object"},
    "runs": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["run_id", "source_root_hash", "confidence", "tdd", "dimensions", "critical_risks"],
        "properties": {
          "run_id": {"type": "string"},
          "source_root_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "tdd": {
            "type": "object",
            "required": ["status", "tests_present", "rationale"],
            "properties": {
              "status": {"enum": ["proven", "partially_evidenced", "not_provable", "not_tdd_proven"]},
              "tests_present": {"type": "boolean"},
              "rationale": {"type": "string"}
            }
          },
          "dimensions": {
            "type": "object",
            "minProperties": 10,
            "maxProperties": 10,
            "additionalProperties": {
              "type": "object",
              "required": ["score", "rationale", "evidence"],
              "properties": {
                "score": {"type": "integer", "minimum": 0, "maximum": 4},
                "rationale": {"type": "string"},
                "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          },
          "critical_risks": {"type": "array"}
        }
      }
    }
  }
}
